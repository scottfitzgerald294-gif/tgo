# Copy to .env only for local development. .env is ignored by Git.
# Keep all values empty in this template.
# Never put real PDD, TGO, model, database, buyer, or production secrets here.
# Phase 3 integrations must remain disabled and must not make external calls.

APP_ENV=
APP_HOST=
APP_PORT=
LOG_LEVEL=
# Local SQLite path only. Never use a production database, URL, or secret here.
PDD_RELIABILITY_DB_PATH=
# Local ignored JSON catalog only. Never use real company knowledge here.
PDD_KNOWLEDGE_CATALOG_PATH=

PDD_INTEGRATION_ENABLED=
PDD_CREDENTIAL_REF=

TGO_INTEGRATION_ENABLED=
TGO_BASE_URL=
TGO_PLATFORM_API_KEY_REF=
